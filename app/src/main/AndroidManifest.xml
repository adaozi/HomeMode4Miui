<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- hotfix7：包可见性。设置页（模块 App 进程）的应用选择列表自建应用清单
         （AppRepository PackageManager MAIN/LAUNCHER 查询），Android 11+ 无此声明
         只能看到系统默认可见的少数应用 —— 隐藏应用/文件夹/图标包等所有选应用入口
         "只有几个应用"的根因。宿主进程不受影响（com.miui.home 是桌面角色）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- B6.2：小米天气 WeatherProvider 包可见性（Android 11+ resolveContentProvider
             需要 authority 声明，否则 query content://weather 直接读不到）。 -->
        <provider android:authorities="weather" />
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">

        <!-- LSPosed 模块声明 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <!-- 模块开关界面。excludeFromRecents：模块页不出现在多任务界面
             （task 根为 MainActivity，LAUNCHER 入口排除即整任务不进 recents；
             路由转发的 SettingsActivity 同声明兜底独立 task 场景）。 -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- C 组（C1）：Grace 设置页（模块 App 进程，正常 Compose Activity，不碰宿主）。
             exported=false：入口统一走 MainActivity route 转发（BAL 可行路径）。
             excludeFromRecents：同 MainActivity，设置页也不进多任务界面。 -->
        <activity
            android:name=".SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/settings_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- P6（B6.1/B6.3）：通知监听服务。系统按 manifest 绑定到本模块 App 进程，
             媒体 token/controller 全在该进程内；快照经 GraceBridgeEngine 广播下发宿主。 -->
        <service
            android:name="com.galaxyrio.gracelauncher.data.media.MediaNotificationListener"
            android:exported="false"
            android:label="@string/media_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 上游同步 v1.1.8 S3：Grace 无障碍服务（无事件订阅/无窗口内容读取/无手势注入，
             仅 performGlobalAction 三个动作：锁屏/拉通知栏/拉快捷设置）。
             服务落模块 App 进程；宿主 com.miui.home 进程的手势/按钮动作经 GRACE 桥
             Cmd.SYSTEM_ACTION 跨进程触发（GraceCommandReceiver → GraceAccessibilityService）。 -->
        <service
            android:name="com.galaxyrio.gracelauncher.platform.GraceAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/grace_accessibility_service" />
        </service>

        <!-- keep1：进程保活入口。宿主 com.miui.home（常驻前台）在桌面挂载/首页
             交互时跨包 startService 拉起模块进程（引擎幂等）；Magisk service.d
             守护脚本亦经此入口拉起。exported=true 仅暴露"幂等启动引擎"一个
             无害动作。 -->
        <service
            android:name=".bridge.GraceKeepAliveService"
            android:exported="true" />

        <!-- P6：宿主命令接收器（媒体控制/通知打开与清除/天气刷新）。
             notif4：改为 GraceBridgeEngine.start() 内动态注册 —— manifest 静态注册
             在 MIUI/HyperOS 上被省电策略拦截（后台模块进程收不到任何命令广播，
             装机实锤：receiver 打点零输出），而快照方向（模块→宿主）的宿主
             receiver 一直是动态注册、工作正常。安全不变：exported 动态注册 +
             onReceive 内校验发送方 uid 必须为 com.miui.home
             （GraceCommandReceiver.fromHost）。 -->

        <!-- B6.2 天气数据源切换为小米天气（com.miui.weather2）WeatherProvider：
             exported 读无权限门槛，无需任何 uses-permission；数据失效走
             GraceBridgeEngine 内动态注册的 ContentObserver（content://weather），
             原 Breezy UPDATE_NOTIFIER manifest receiver 随之移除。 -->
    </application>
</manifest>
